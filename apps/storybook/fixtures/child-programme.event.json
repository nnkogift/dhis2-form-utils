    "programRules": [
        {
            "id": "NAgjOfWMXg6",
            "displayName": "Ask for comment for low apgar",
            "condition": "#{apgarscore} >= 0 && #{apgarscore} < 4 && #{apgarcomment} == ''",
            "programRuleActions": [
                {
                    "programRuleActionType": "SHOWWARNING",
                    "content": "It is suggested that an explanation is provided when the Apgar score is below 4",
                    "dataElement": {
                        "id": "H6uSAMO5WLD",
                        "displayName": "MCH Apgar comment",
                        "displayFormName": "Apgar comment",
                        "valueType": "LONG_TEXT"
                    }
                }
            ]
        },
        {
            "id": "tTPMkizzUZg",
            "displayName": "Demand comment if apgar is under zero",
            "condition": "#{apgarscore} <0 && #{apgarcomment} == ''",
            "programRuleActions": [
                {
                    "programRuleActionType": "SHOWERROR",
                    "content": "If the apgar score is below zero, an explanation must be provided.",
                    "dataElement": {
                        "id": "a3kGcGDCuk6",
                        "displayName": "MCH Apgar Score",
                        "displayFormName": "Apgar Score",
                        "valueType": "NUMBER",
                        "description": "Apgar is a quick test performed on a baby at 1 and 5 minutes after birth. The 1-minute score determines how well the baby tolerated the birthing process. The 5-minute score tells the doctor how well the baby is doing outside the mother's womb."
                    }
                }
            ]
        },
        {
            "id": "ppdTpuQC7Q5",
            "displayName": "Hide Apgar comment if score > 7",
            "condition": "#{apgarscore} > 7",
            "programRuleActions": [
                {
                    "programRuleActionType": "HIDEFIELD",
                    "dataElement": {
                        "id": "H6uSAMO5WLD",
                        "displayName": "MCH Apgar comment",
                        "displayFormName": "Apgar comment",
                        "valueType": "LONG_TEXT"
                    }
                }
            ]
        }
    ],
