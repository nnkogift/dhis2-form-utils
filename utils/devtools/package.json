{
    "name": "@nnkogift/dhis2-form-utils-devtools",
    "version": "0.1.0-alpha.5",
    "description": "Developer tools for debugging DHIS2 program rules in dhis2-form-utils forms",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/nnkogift/dhis2-form-utils.git",
        "directory": "utils/devtools"
    },
    "homepage": "https://github.com/nnkogift/dhis2-form-utils#readme",
    "type": "module",
    "sideEffects": [
        "./dist/index.css"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./effect-styles": {
            "import": {
                "types": "./dist/effectStyles.d.ts",
                "default": "./dist/effectStyles.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./scope": {
            "import": {
                "types": "./dist/RuleDevtoolsScope.d.ts",
                "default": "./dist/RuleDevtoolsScope.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./style.css": "./dist/index.css"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "tsup && tailwindcss -i ./src/tailwind.css -o ./dist/index.css --minify && node ../../packages/config/copyEntryDtsCts.mjs",
        "dev": "concurrently -n tsup,css -c blue,magenta \"tsup --watch\" \"tailwindcss -i ./src/tailwind.css -o ./dist/index.css --watch\"",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@nnkogift/dhis2-form-utils-hooks": "workspace:*",
        "@nnkogift/dhis2-form-utils-metadata": "workspace:*",
        "@xyflow/react": "^12.11.1"
    },
    "peerDependencies": {
        "@dhis2/app-runtime": ">=3.0.0",
        "@dhis2/d2-i18n": ">=1.0.0",
        "@dhis2/ui": ">=10.0.0",
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    },
    "devDependencies": {
        "@nnkogift/dhis2-form-utils-config": "workspace:*",
        "@dhis2/app-runtime": "^3.17.0",
        "@dhis2/d2-i18n": "^1.2.0",
        "@dhis2/data-engine": "^3.17.0",
        "@dhis2/ui": "^10.15.1",
        "@tailwindcss/cli": "^4.3.2",
        "@testing-library/react": "^16.3.2",
        "concurrently": "^10.0.0",
        "@types/react": "^18.3.29",
        "@types/react-dom": "^18.3.7",
        "jsdom": "^29.1.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tailwindcss": "^4.3.2",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=18"
    }
}
