{
    "name": "@nnkogift/dhis2-form-utils-rules",
    "version": "0.1.0-alpha.1",
    "description": "DHIS2 program rule evaluation and field state mapping for React forms",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/nnkogift/dhis2-form-utils.git",
        "directory": "utils/rules"
    },
    "homepage": "https://github.com/nnkogift/dhis2-form-utils#readme",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "tsup && node ../../packages/config/copyEntryDtsCts.mjs",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@nnkogift/dhis2-form-utils-metadata": "workspace:*"
    },
    "peerDependencies": {
        "@dhis2/rule-engine": ">=3.8.2"
    },
    "devDependencies": {
        "@nnkogift/dhis2-form-utils-config": "workspace:*",
        "@dhis2/api-types": "43.0.0-beta.daa0d8e",
        "@dhis2/rule-engine": "3.8.2",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=18"
    }
}
