{
    "name": "@nnkogift/dhis2-form-utils-hooks",
    "version": "0.1.0-alpha.7",
    "description": "Headless React hooks for DHIS2 form lifecycle",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/nnkogift/dhis2-form-utils.git",
        "directory": "utils/hooks"
    },
    "homepage": "https://github.com/nnkogift/dhis2-form-utils#readme",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "tsup && node ../../packages/config/copyEntryDtsCts.mjs",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@nnkogift/dhis2-form-utils-metadata": "workspace:*",
        "@nnkogift/dhis2-form-utils-rules": "workspace:*"
    },
    "peerDependencies": {
        "@dhis2/app-runtime": ">=3.0.0",
        "@hookform/resolvers": ">=3.0.0",
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0",
        "react-hook-form": ">=7.0.0",
        "zod": ">=3.0.0"
    },
    "devDependencies": {
        "@nnkogift/dhis2-form-utils-config": "workspace:*",
        "@dhis2/api-types": "43.0.0-beta.daa0d8e",
        "@dhis2/app-runtime": "^3.17.0",
        "@dhis2/data-engine": "^3.17.0",
        "@hookform/resolvers": "^5.2.2",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^18.3.29",
        "@types/react-dom": "^18.3.7",
        "jsdom": "^29.1.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.76.0",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10",
        "zod": "^3.25.76"
    },
    "engines": {
        "node": ">=18"
    }
}
