{
    "name": "@nnkogift/dhis2-form-utils-dhis2-ui",
    "version": "0.1.0-alpha.8",
    "description": "DHIS2 UI field components and forms for dhis2-form-utils",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/nnkogift/dhis2-form-utils.git",
        "directory": "components/dhis2-ui"
    },
    "homepage": "https://github.com/nnkogift/dhis2-form-utils#readme",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@nnkogift/dhis2-form-utils-hooks": "workspace:*",
        "maplibre-gl": "^6.1.0",
        "terra-draw": "^1.32.2",
        "terra-draw-maplibre-gl-adapter": "^1.4.1"
    },
    "peerDependencies": {
        "@dhis2/app-runtime": ">=3.0.0",
        "@dhis2/ui": ">=9.0.0",
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0",
        "react-hook-form": ">=7.0.0"
    },
    "devDependencies": {
        "@nnkogift/dhis2-form-utils-config": "workspace:*",
        "@nnkogift/dhis2-form-utils-map": "workspace:*",
        "@dhis2/app-runtime": "^3.17.0",
        "@dhis2/ui": "^10.15.1",
        "@types/react": "^18.3.29",
        "@types/react-dom": "^18.3.7",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.76.0",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=18"
    }
}
