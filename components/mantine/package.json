{
    "name": "@nnkogift/dhis2-form-utils-mantine",
    "version": "0.0.0",
    "description": "Mantine field components and forms for dhis2-form-utils",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nnkogift/dhis2-form-utils.git",
        "directory": "components/mantine"
    },
    "homepage": "https://github.com/nnkogift/dhis2-form-utils#readme",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@nnkogift/dhis2-form-utils-hooks": "workspace:*"
    },
    "peerDependencies": {
        "@mantine/core": ">=7.0.0",
        "@mantine/dates": ">=7.0.0",
        "@mantine/hooks": ">=7.0.0",
        "dayjs": ">=1.11.0",
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0",
        "react-hook-form": ">=7.0.0"
    },
    "devDependencies": {
        "@nnkogift/dhis2-form-utils-config": "workspace:*",
        "@mantine/core": "^7.17.8",
        "@mantine/dates": "^7.17.8",
        "@mantine/hooks": "^7.17.8",
        "@types/react": "^18.3.29",
        "@types/react-dom": "^18.3.7",
        "dayjs": "^1.11.21",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.76.0",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.7"
    },
    "engines": {
        "node": ">=18"
    }
}
