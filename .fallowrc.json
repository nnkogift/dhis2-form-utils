{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}",
    "apps/playground/src/AppWrapper.tsx"
  ],
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "utils/*",
      "components/*"
    ]
  },
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3,
    "ignore": [
      // Storybook stories are deliberately duplicated one file per UI adapter
      // (dhis2-ui/mantine/mui) for parity and easy side-by-side comparison.
      "apps/storybook/stories/**"
    ]
  },
  "rules": {
    "unused-dependencies": "warn"
  },
  "ignoreDependencies": [
    // Consumed as a source-only (unbuilt) internal package by dhis2-ui/mantine/mui
    // via MapFields.tsx — fallow's dependency-usage detector doesn't resolve it.
    "@nnkogift/dhis2-form-utils-map",
    // Only imported inside packages/map/src, which dhis2-ui/mantine/mui bundle
    // directly (map has no build step of its own). Each adapter must still
    // declare these as real dependencies so they're installed at runtime —
    // fallow attributes the import to the map workspace instead.
    "terra-draw",
    "terra-draw-maplibre-gl-adapter"
  ]
}
